{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wattzap.internal/brand/schemas/slide-content.schema.json",
  "title": "WattZap slide content",
  "description": "Structured content for one WattZap slide. Content only — all design (colours, fonts, layout, logo, grid, glows, margins) comes from brand tokens and master templates. Enforced at render time by tools/wattzap-brand-studio/validator/content-schema.mjs.",
  "type": "object",
  "required": ["template", "title", "content"],
  "additionalProperties": false,
  "properties": {
    "template": {
      "enum": [
        "title-slide",
        "three-column-overview",
        "four-card-requirements",
        "process-flow",
        "architecture",
        "timeline",
        "business-case",
        "comparison"
      ]
    },
    "deck": { "type": "string", "maxLength": 90, "description": "Deck name, used for grouping and reports." },
    "slideNumber": { "type": "integer", "minimum": 1 },
    "totalSlides": { "type": "integer", "minimum": 1 },
    "sectionLabel": { "type": "string", "maxLength": 40, "description": "Uppercase label shown top-right in the header." },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "titleAccent": { "type": "string", "maxLength": 60, "description": "Substring of title rendered in the cyan-to-green gradient." },
    "subtitle": { "type": "string", "maxLength": 110 },
    "supporting": { "type": "string", "maxLength": 220 },
    "footerNote": { "type": "string", "maxLength": 90, "default": "WattZap Energy Solutions — Confidential" },
    "a11yLabel": { "type": "string", "maxLength": 200, "description": "Accessible description of the slide image; defaults to title." },
    "content": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "template": { "const": "title-slide" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kicker": { "type": "string", "maxLength": 60 },
              "highlights": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 70 } },
              "dateLine": { "type": "string", "maxLength": 90 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "template": { "const": "three-column-overview" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["columns"],
            "additionalProperties": false,
            "properties": {
              "columns": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/definitions/bulletCard" }
              },
              "outcomes": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 70 } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "template": { "const": "four-card-requirements" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["cards"],
            "additionalProperties": false,
            "properties": {
              "cards": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "$ref": "#/definitions/bulletCardMax4" }
              },
              "note": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "template": { "const": "process-flow" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["steps"],
            "additionalProperties": false,
            "properties": {
              "steps": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": ["heading"],
                  "additionalProperties": false,
                  "properties": {
                    "icon": { "$ref": "#/definitions/icon" },
                    "heading": { "type": "string", "maxLength": 60 },
                    "caption": { "type": "string", "maxLength": 120 }
                  }
                }
              },
              "outcomes": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 70 } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "template": { "const": "architecture" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["layers"],
            "additionalProperties": false,
            "properties": {
              "layers": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": ["heading", "items"],
                  "additionalProperties": false,
                  "properties": {
                    "icon": { "$ref": "#/definitions/icon" },
                    "heading": { "type": "string", "maxLength": 60 },
                    "items": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "maxLength": 40 } }
                  }
                }
              },
              "note": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "template": { "const": "timeline" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["milestones"],
            "additionalProperties": false,
            "properties": {
              "milestones": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": ["label", "heading"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string", "maxLength": 30 },
                    "heading": { "type": "string", "maxLength": 60 },
                    "bullets": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 90 } }
                  }
                }
              },
              "note": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "template": { "const": "business-case" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["metrics"],
            "additionalProperties": false,
            "properties": {
              "metrics": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "value": { "type": "string", "maxLength": 16 },
                    "label": { "type": "string", "maxLength": 40 },
                    "caption": { "type": "string", "maxLength": 90 }
                  }
                }
              },
              "bullets": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 90 } },
              "note": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "template": { "const": "comparison" } } },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["options"],
            "additionalProperties": false,
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["heading", "bullets"],
                  "additionalProperties": false,
                  "properties": {
                    "icon": { "$ref": "#/definitions/icon" },
                    "heading": { "type": "string", "maxLength": 60 },
                    "tagline": { "type": "string", "maxLength": 110 },
                    "badge": { "type": "string", "maxLength": 40 },
                    "featured": { "type": "boolean" },
                    "bullets": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "maxLength": 90 } }
                  }
                }
              },
              "note": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Name of an icon in brand/assets/icons/ (without .svg)."
    },
    "bulletCard": {
      "type": "object",
      "required": ["heading", "bullets"],
      "additionalProperties": false,
      "properties": {
        "icon": { "$ref": "#/definitions/icon" },
        "heading": { "type": "string", "maxLength": 60 },
        "bullets": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "maxLength": 90 } }
      }
    },
    "bulletCardMax4": {
      "type": "object",
      "required": ["heading", "bullets"],
      "additionalProperties": false,
      "properties": {
        "icon": { "$ref": "#/definitions/icon" },
        "heading": { "type": "string", "maxLength": 60 },
        "bullets": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 90 } }
      }
    }
  }
}
